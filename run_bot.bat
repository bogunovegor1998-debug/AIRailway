@echo off
REM ======================================================
REM Бесконечный цикл перезапуска бота
REM При падении процесса (ошибка сети, os._exit, etc.)
REM автоматически перезапускает python -m src.bot.main
REM ======================================================
REM Для остановки: закройте окно или нажмите Ctrl+C

:loop
echo.
echo ==========================================
echo [%date% %time%] Запуск бота...
echo ==========================================
.venv\Scripts\python -m src.bot.main

echo.
echo [%date% %time%] Бот завершил работу с кодом %ERRORLEVEL%.
echo Перезапуск через 5 секунд...
timeout /t 5 /nobreak >nul
goto loop

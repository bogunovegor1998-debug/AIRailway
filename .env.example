# ============================================================================
# AIRailway — пример переменных окружения.
# Скопируйте файл в .env и заполните реальными значениями:
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Linux/macOS)
# Значения-заглушки (your_..._here) замените своими. .env в репозиторий не коммитится.
# ============================================================================

# ===== Telegram =====
# Токен бота, полученный у @BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here
# chat_id получателя (дайджест и служебные сообщения). Узнать можно у @userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here

# ===== PostgreSQL =====
# Строка подключения SQLAlchemy. Нужна БД с расширением pgvector (для слоя регламентов).
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/airailway

# ===== DeepSeek API (используется только для форматирования текста ответов) =====
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== Параметры прохода (раздельные потоки) =====
# Время прохода одного пассажира через один турникет, сек (поток «прибытие»)
TURNSTILE_PASS_SECONDS=6
# Время прохода одного пассажира через одну рамку, сек (поток «отправление»)
FRAME_PASS_SECONDS=10

# ===== Всего единиц оборудования на вокзале =====
FRAMES_TOTAL=17
TURNSTILES_TOTAL=17

# ===== Пороги зон нагрузки, минуты =====
# до ZONE_GREEN_MAX — зелёная зона; до ZONE_YELLOW_MAX — жёлтая; выше — красная
ZONE_GREEN_MAX=3
ZONE_YELLOW_MAX=5

# ===== Порог «большого количества пассажиров» (пассажиров на поезд) =====
# Выше этого значения часу добавляется причина «большое количество пассажиров»
PASSENGERS_PER_TRAIN_THRESHOLD=500

# ===== Расписание ежедневного дайджеста (Europe/Moscow) =====
DAILY_DIGEST_HOUR=7
DAILY_DIGEST_MINUTE=0

# ===== Вокзал и геолокация (для погоды и парсера мероприятий) =====
# Название вокзала по умолчанию совпадает со значением в src/config.py
STATION_NAME=Ленинградский вокзал
STATION_LAT=55.7766
STATION_LON=37.6553

# ===== Погода =====
# Город для прогноза wttr.in (латиницей)
WEATHER_CITY=Moscow

# ===== Доступ к боту =====
# Пароль на вход в бота. Пустая строка = бот доступен без пароля.
BOT_PASSWORD=

# ===== Данные =====
# Локальная папка с исходными выгрузками (Excel/CSV). В репозитории данных нет.
DATA_DIR=data
